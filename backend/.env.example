# Copy to backend/.env for local development. Do not commit backend/.env.
DB_URL=jdbc:mysql://localhost:3306/hospital_management?useSSL=false&serverTimezone=UTC
DB_USERNAME=your_mysql_username
DB_PASSWORD=replace_with_your_local_password
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=replace_with_a_local_development_password
SEED_ADMIN_NAME=Administrator
RESET_ADMIN_PASSWORD=false
SESSION_TIMEOUT=30m
SESSION_COOKIE_SECURE=false
